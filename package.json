{
  "name": "learning-rogue",
  "private": true,
  "version": "1.0.0",
  "description": "学習問題とカードバトルを組み合わせた学習ローグライクゲーム",
  "author": "YIICTSC",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "dev:debug": "VITE_ENABLE_DEBUG_FEATURES=true vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "build:steam": "node scripts/build-steam.mjs",
    "build:ios": "node scripts/generate-icons.mjs && VITE_APP_PLATFORM=ios VITE_PAID_EDITION=true vite build",
    "build:android": "node scripts/generate-icons.mjs && node scripts/generate-android-icons.mjs && node scripts/generate-android-asset-manifest.mjs && node scripts/verify-android-asset-manifest.mjs && VITE_APP_PLATFORM=android VITE_PAID_EDITION=true VITE_LARGE_ASSET_BASE_URL=https://yiictsc.github.io/math-rogue/ vite build && node scripts/prepare-android-dist.mjs",
    "ios:add": "pnpm run build:ios && cap add ios --packagemanager SPM",
    "ios:sync": "pnpm run build:ios && cap sync ios",
    "ios:open": "cap open ios",
    "ios:prepare-simulator": "xcrun simctl runtime dyld_shared_cache update --all",
    "ios:run": "bash scripts/ios-build-launch.sh",
    "android:add": "pnpm run build:android && cap add android",
    "android:sync": "pnpm run build:android && cap sync android",
    "android:open": "cap open android",
    "android:icons": "node scripts/generate-android-icons.mjs",
    "audit:hiragana": "node scripts/audit-hiragana-ui.mjs",
    "audit:english": "node scripts/audit-english-ui.mjs",
    "audit:display-copy": "node scripts/audit-display-copy.mjs",
    "audit:translations": "npm run audit:english && npm run audit:hiragana && npm run audit:display-copy",
    "test:management": "node scripts/verify-management-integration.mjs",
    "test:assignment-notifications": "node scripts/test-assignment-notifications.mjs",
    "test:required-battle-voices": "node scripts/verify-required-battle-voices.mjs",
    "test:triggered-card-damage": "node scripts/verify-triggered-card-damage.mjs",
    "test:production-debug-lock": "node scripts/verify-production-debug-lock.mjs",
    "test:gamepad": "node scripts/test-xbox-controller.mjs",
    "test:ios-bgm": "node scripts/test-ios-bgm.mjs",
    "test:ios-magic-rule-panel": "node scripts/verify-ios-magic-rule-panel.mjs",
    "test:android-asset-manifest": "node scripts/verify-android-asset-manifest.mjs",
    "test:assignment-reward-synthesis": "node scripts/test-assignment-reward-and-english-synthesis.mjs",
    "test:assignment-reward-runtime": "node scripts/test-assignment-reward-runtime.mjs",
    "build:offline": "node scripts/build-offline.mjs",
    "build:icons": "node scripts/generate-icons.mjs",
    "compress:bgm": "node scripts/compress-bgm.mjs",
    "cleanup:dist-assets": "node scripts/cleanup-dist-assets.mjs",
    "convert:sprites:webp": "node scripts/convert-sprites-to-webp.mjs",
    "dist:offline": "node scripts/generate-icons.mjs && node scripts/build-offline.mjs && electron-builder --win nsis:x64",
    "dist:steam:win": "node scripts/generate-icons.mjs && node scripts/build-steam.mjs && electron-builder --config electron-builder.steam.yml --win --x64 && node scripts/verify-steam-build.mjs",
    "steam:assets": "node scripts/generate-steam-assets.mjs",
    "steam:config": "node scripts/generate-steampipe-config.mjs",
    "steam:verify": "node scripts/verify-steam-build.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 4173"
  },
  "build": {
    "appId": "jp.learningrogue.offline",
    "productName": "学習ローグ オフライン版",
    "electronLanguages": [
      "ja",
      "en-US"
    ],
    "directories": {
      "output": "release"
    },
    "toolsets": {
      "winCodeSign": "1.1.0"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "protocols": [
      {
        "name": "Learning Rogue Assignment",
        "schemes": [
          "learning-rogue"
        ]
      }
    ],
    "asar": true,
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "学習ローグ-オフライン版-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "学習ローグ オフライン版",
      "runAfterFinish": true
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "^8.4.2",
    "@capacitor/file-transfer": "^2.0.4",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/ios": "^8.4.2",
    "@capacitor/local-notifications": "^8.2.1",
    "@types/katex": "^0.16.8",
    "@vitejs/plugin-react": "^5.1.1",
    "katex": "^0.16.47",
    "lucide-react": "^0.555.0",
    "peerjs": "^1.5.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite": "^7.2.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.5.0",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "ffmpeg-static": "^5.3.0",
    "playwright": "^1.61.1",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.5.15",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
