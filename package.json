{
  "name": "learning-rogue",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "build:offline": "VITE_OFFLINE_DISTRIBUTABLE=true vite build",
    "build:icons": "node scripts/generate-icons.mjs",
    "dist:offline": "node scripts/generate-icons.mjs && VITE_OFFLINE_DISTRIBUTABLE=true vite build && electron-builder --win nsis:x64",
    "preview": "vite preview --host 0.0.0.0 --port 4173"
  },
  "build": {
    "appId": "jp.learningrogue.offline",
    "productName": "学習ローグ オフライン版",
    "directories": {
      "output": "release"
    },
    "toolsets": {
      "winCodeSign": "1.1.0"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "学習ローグ-オフライン版-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "学習ローグ オフライン版",
      "runAfterFinish": true
    }
  },
  "dependencies": {
    "@google/genai": "^1.31.0",
    "@vitejs/plugin-react": "^5.1.1",
    "lucide-react": "^0.555.0",
    "peerjs": "^1.5.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite": "^7.2.4"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.5.0",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.5.15",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
