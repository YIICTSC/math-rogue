# Optional dedicated game server. Empty/unset uses the legacy PeerJS transport.
VITE_ONLINE_SERVER_URL=https://learning-rogue-online.onrender.com

# Optional Quiz Show dedicated server (must support /quiz-show). Unset: host-device PeerJS.
# VITE_QUIZ_SHOW_SERVER_URL=https://learning-rogue-online.onrender.com
# Public invitation URL override, especially for native app builds.
# VITE_QUIZ_SHOW_PUBLIC_URL=https://yiictsc.github.io/math-rogue/
# Optional ICE servers, as a JSON array. Leave credentials outside Git.
# VITE_QUIZ_SHOW_ICE_SERVERS=
